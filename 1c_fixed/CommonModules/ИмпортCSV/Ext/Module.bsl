Функция ИмпортироватьCSV(ТекстCSV) Экспорт

    // 1. Читаем данные из CSV
    Данные = ПодготовитьДанныеИмпорта(ТекстCSV);

    // 2. Записываем данные в базу 1С
    ЗаписатьДанныеВБазу(Данные);

    // 3. СОБИРАЕМ ДАННЫЕ ДЛЯ GO-БЭКЕНДА
    МассивДляБэка = Новый Массив;
    ТипДанных = ""; // Сюда запишем, что именно мы парсим

   Если Данные.Свойство("leads") И Данные.leads.Количество() > 0 Тогда
    ТипДанных = "leads";
    Для Каждого Стр Из Данные.leads Цикл
    НовЭл = Новый Структура;
    НовЭл.Вставить("lead_id", Формат(Стр.lead_id, "ЧГ=0"));
    
    СтрокаДаты = Формат(Стр.created_at, "ДФ=yyyy-MM-dd'T'HH:mm:ss") + "Z";
    НовЭл.Вставить("created_at", СтрокаДаты);
    
    НовЭл.Вставить("source", Стр.source);
    НовЭл.Вставить("current_stage", Стр.current_stage);
    
    // но бэкенд на Go ждет поле "owner" (посмотри в import_json.go). 
    // Если оставить "manager", в базе Go менеджер будет пустым.
    НовЭл.Вставить("manager", Стр.manager); 
    
    // --- ДОБАВЛЯЕМ НОВЫЕ ПОЛЯ ---
    НовЭл.Вставить("full_name", Стр.full_name);
    НовЭл.Вставить("note", Стр.note);
    
    // Можешь заодно сразу добавить телефон и почту, бэк их тоже примет:
    // НовЭл.Вставить("phone", Стр.phone);
    // НовЭл.Вставить("email", Стр.email);
    
    МассивДляБэка.Добавить(НовЭл);
КонецЦикла;	
    ИначеЕсли Данные.Свойство("sources") И Данные.sources.Количество() > 0 Тогда
        ТипДанных = "sources";
        Для Каждого Стр Из Данные.sources Цикл
            НовЭл = Новый Структура;
            НовЭл.Вставить("code_name", Стр.code_name);
            НовЭл.Вставить("name", Стр.name);
            МассивДляБэка.Добавить(НовЭл);
        КонецЦикла;
        
    ИначеЕсли Данные.Свойство("employees") И Данные.employees.Количество() > 0 Тогда
        ТипДанных = "employees";
        Для Каждого Стр Из Данные.employees Цикл
            НовЭл = Новый Структура;
            НовЭл.Вставить("full_name", Стр.full_name);
            НовЭл.Вставить("email", Стр.email);
            НовЭл.Вставить("role", Стр.role);
            МассивДляБэка.Добавить(НовЭл);
		КонецЦикла;       
	ИначеЕсли Данные.Свойство("contacts") И Данные.contacts.Количество() > 0 Тогда
        ТипДанных = "contacts";
        Для Каждого Стр Из Данные.contacts Цикл
            НовЭл = Новый Структура;
            // Форматируем ID как строку без пробелов тысяч
            НовЭл.Вставить("lead_id", Формат(Стр.lead_id, "ЧГ=0"));
            НовЭл.Вставить("full_name", Стр.full_name);
            НовЭл.Вставить("email", Стр.email);
            
            МассивДляБэка.Добавить(НовЭл);
        КонецЦикла;
	КонецЕсли;        
	
	

    // Возвращаем и сам массив, и тип файла, чтобы HTTP-сервис знал, куда его слать
    Результат = Новый Структура;
    Результат.Вставить("ТипДанных", ТипДанных);
    Результат.Вставить("МассивДанных", МассивДляБэка);
    
    Возврат Результат;

КонецФункции




Функция ПодготовитьДанныеИмпорта(ТекстCSV) Экспорт

    Данные = Новый Структура;

    // =========================================================================
    // LEADS
    // =========================================================================

    ТаблицаLeads = Новый ТаблицаЗначений;

    ТаблицаLeads.Колонки.Добавить("lead_id");
    ТаблицаLeads.Колонки.Добавить("created_at");
    ТаблицаLeads.Колонки.Добавить("source");
    ТаблицаLeads.Колонки.Добавить("current_stage");
    ТаблицаLeads.Колонки.Добавить("manager");     
	ТаблицаLeads.Колонки.Добавить("full_name"); 
	ТаблицаLeads.Колонки.Добавить("note"); 
    Данные.Вставить("leads", ТаблицаLeads);

    // =========================================================================
    // LEAD STAGES
    // =========================================================================

    ТаблицаLeadStages = Новый ТаблицаЗначений;

    ТаблицаLeadStages.Колонки.Добавить("lead_id");
    ТаблицаLeadStages.Колонки.Добавить("stage");
    ТаблицаLeadStages.Колонки.Добавить("entered_at");
    ТаблицаLeadStages.Колонки.Добавить("left_at");

    Данные.Вставить("lead_stages", ТаблицаLeadStages);

    // =========================================================================
    // SOURCES
    // =========================================================================

    ТаблицаSources = Новый ТаблицаЗначений;

    ТаблицаSources.Колонки.Добавить("code_name");
    ТаблицаSources.Колонки.Добавить("name");

    Данные.Вставить("sources", ТаблицаSources);

    // =========================================================================
    // EMPLOYEES
    // =========================================================================

    ТаблицаEmployees = Новый ТаблицаЗначений;

    ТаблицаEmployees.Колонки.Добавить("full_name");
    ТаблицаEmployees.Колонки.Добавить("email");
    ТаблицаEmployees.Колонки.Добавить("role");

    Данные.Вставить("employees", ТаблицаEmployees);

    // =========================================================================
    // CONTACTS
    // =========================================================================

    ТаблицаContacts = Новый ТаблицаЗначений;

    ТаблицаContacts.Колонки.Добавить("lead_id");
    ТаблицаContacts.Колонки.Добавить("full_name");
    ТаблицаContacts.Колонки.Добавить("email");

    Данные.Вставить("contacts", ТаблицаContacts);



    // =========================================================================
    // ЧТЕНИЕ CSV
    // =========================================================================

    Текст = Новый ТекстовыйДокумент;
    Текст.УстановитьТекст(ТекстCSV);

    Если Текст.КоличествоСтрок() < 2 Тогда
        ВызватьИсключение "Файл должен содержать данные";
    КонецЕсли;

    // =========================================================================
    // ЗАГОЛОВОК
    // =========================================================================

    СтрокаЗаголовок = Текст.ПолучитьСтроку(1);

    МассивЗаголовков = СтрРазделить(СтрокаЗаголовок,",",Ложь);

    Для Индекс = 0 По МассивЗаголовков.ВГраница() Цикл
        МассивЗаголовков[Индекс] = СокрЛП(МассивЗаголовков[Индекс]);
    КонецЦикла;

    ТипФайла = ОпределитьТипФайла(МассивЗаголовков);

    Если ТипФайла = Неопределено Тогда
        ВызватьИсключение "Не удалось определить тип CSV";
    КонецЕсли;

    // =========================================================================
    // ЧТЕНИЕ СТРОК
    // =========================================================================

    Для НомерСтроки = 2 По Текст.КоличествоСтрок() Цикл

        ТекущаяСтрока = Текст.ПолучитьСтроку(НомерСтроки);

        Если ПустаяСтрока(ТекущаяСтрока) Тогда
            Продолжить;
        КонецЕсли;

        МассивЭлементов = СтрРазделить(ТекущаяСтрока,",",Ложь);

        Если МассивЭлементов.Количество() <> МассивЗаголовков.Количество() Тогда
            Продолжить;
        КонецЕсли;

        // =====================================================================
        // SOURCES
        // =====================================================================

        Если ТипФайла = "sources" Тогда
            НоваяСтрока =
                Данные.sources.Добавить();
            НоваяСтрока.code_name =
                СокрЛП(МассивЭлементов[0]);
            НоваяСтрока.name =
                СокрЛП(МассивЭлементов[1]);

        // =====================================================================
        // EMPLOYEES
        // =====================================================================

        ИначеЕсли ТипФайла = "employees" Тогда

            НоваяСтрока =
                Данные.employees.Добавить();

            НоваяСтрока.full_name =
                СокрЛП(МассивЭлементов[0]);

            НоваяСтрока.email =
                СокрЛП(МассивЭлементов[1]);

            НоваяСтрока.role =
                СокрЛП(МассивЭлементов[2]);

        // =====================================================================
        // LEADS
        // =====================================================================

        ИначеЕсли ТипФайла = "leads" Тогда

            НоваяСтрока =
                Данные.leads.Добавить();

            НоваяСтрока.lead_id =
                Число(
                    СокрЛП(МассивЭлементов[0])
                );

            НоваяСтрока.created_at =
                ПреобразоватьДатуИзCSV(
                    МассивЭлементов[1]
                );

            НоваяСтрока.source =
                СокрЛП(МассивЭлементов[2]);

            НоваяСтрока.current_stage =
                СокрЛП(МассивЭлементов[3]);

            НоваяСтрока.manager =
                СокрЛП(МассивЭлементов[4]); 
			НоваяСтрока.manager = СокрЛП(МассивЭлементов[4]);

// ДОБАВЛЯЕМ ЧТЕНИЕ НОВЫХ ПОЛЕЙ, ЕСЛИ ОНИ ЕСТЬ В ФАЙЛЕ
// Внутри парсера, где идет заполнение НоваяСтрока
НоваяСтрока.manager = СокрЛП(МассивЭлементов[4]);

// Добавь это:
Если МассивЭлементов.Количество() >= 7 Тогда
    НоваяСтрока.full_name = СокрЛП(МассивЭлементов[5]); // 6-я колонка
    НоваяСтрока.note   = СокрЛП(МассивЭлементов[6]); // 7-я колонка
КонецЕсли;
        // =====================================================================
        // LEAD STAGES
        // =====================================================================

        ИначеЕсли ТипФайла = "lead_stages" Тогда

            НоваяСтрока =
                Данные.lead_stages.Добавить();

            НоваяСтрока.lead_id =
                Число(
                    СокрЛП(МассивЭлементов[0])
                );

            НоваяСтрока.stage =
                СокрЛП(МассивЭлементов[1]);

            НоваяСтрока.entered_at =
                ПреобразоватьДатуИзCSV(
                    МассивЭлементов[2]
                );

            НоваяСтрока.left_at =
                ПреобразоватьДатуИзCSV(
                    МассивЭлементов[3]
                );

        // =====================================================================
        // CONTACTS
        // =====================================================================

        ИначеЕсли ТипФайла = "contacts" Тогда

            НоваяСтрока =
                Данные.contacts.Добавить();

            НоваяСтрока.lead_id =
                Число(
                    СокрЛП(МассивЭлементов[0])
                );

            НоваяСтрока.full_name =
                СокрЛП(МассивЭлементов[1]);

            НоваяСтрока.email =
                СокрЛП(МассивЭлементов[2]);

        КонецЕсли;

    КонецЦикла;

    Возврат Данные;

КонецФункции


Процедура ЗаписатьДанныеВБазу(Данные) Экспорт

    // =========================================================================
    // SOURCES
    // =========================================================================

    Если Данные.sources.Количество() > 0 Тогда

        Для Каждого СтрокаДанных Из Данные.sources Цикл

            Найденный =
                Справочники.sources.НайтиПоКоду(
                    СтрокаДанных.code_name
                );

            Если Найденный =
               Справочники.sources.ПустаяСсылка() Тогда

                НовыйЭл =
                    Справочники.sources.СоздатьЭлемент();

                НовыйЭл.Код =
                    СтрокаДанных.code_name;

                НовыйЭл.Наименование =
                    СтрокаДанных.name;

                НовыйЭл.code_name =
                    СтрокаДанных.code_name;

                НовыйЭл.name =
                    СтрокаДанных.name;

                НовыйЭл.Записать();

            КонецЕсли;

        КонецЦикла;

    КонецЕсли;



    // =========================================================================
    // EMPLOYEES
    // =========================================================================

    Если Данные.employees.Количество() > 0 Тогда

        Для Каждого СтрокаДанных Из Данные.employees Цикл

            Попытка

                СсылкаНаРоль =
                    Перечисления.Роли[
                        СтрокаДанных.role
                    ];

            Исключение

                СсылкаНаРоль =
                    Перечисления.Роли.ПустаяСсылка();

            КонецПопытки;

            Найденный =
                Справочники.employees.НайтиПоРеквизиту(
                    "email",
                    СтрокаДанных.email
                );

            Если Найденный =
               Справочники.employees.ПустаяСсылка() Тогда

                НовыйЭл =
                    Справочники.employees.СоздатьЭлемент();

                НовыйЭл.Наименование =
                    СтрокаДанных.full_name;

                НовыйЭл.full_name =
                    СтрокаДанных.full_name;

                НовыйЭл.email =
                    СтрокаДанных.email;

                НовыйЭл.role =
                    СсылкаНаРоль;

                НовыйЭл.Записать();

            КонецЕсли;

        КонецЦикла;

    КонецЕсли;



    // =========================================================================
    // LEADS
    // =========================================================================

    Если Данные.leads.Количество() > 0 Тогда

        МассивLeadID = Новый Массив;
        МассивSources = Новый Массив;
        МассивManagers = Новый Массив;

        Для Каждого Стр Из Данные.leads Цикл

            МассивLeadID.Добавить(Стр.lead_id);
            МассивSources.Добавить(Стр.source);
            МассивManagers.Добавить(Стр.manager);

        КонецЦикла;

        КэшЛидов =ПолучитьКэш("leads","lead_id",МассивLeadID);

        КэшИсточников =ПолучитьКэш("sources","Наименование",МассивSources);

        КэшМенеджеров =ПолучитьКэш("employees","full_name",МассивManagers);

        НачатьТранзакцию();

        Для Каждого СтрокаДанных Из Данные.leads Цикл

            Если КэшЛидов.Получить(СтрокаДанных.lead_id) <> Неопределено Тогда

                Продолжить;

            КонецЕсли;

            СсылкаНаИсточник =КэшИсточников.Получить(СтрокаДанных.source);

            СсылкаНаМенеджера =КэшМенеджеров.Получить(СтрокаДанных.manager);

            Попытка

                СсылкаНаСтадию =
                    Перечисления.Стадии[
                        СтрокаДанных.current_stage
                    ];

            Исключение

                СсылкаНаСтадию =
                    Перечисления.Стадии.ПустаяСсылка();

            КонецПопытки;

            НовыйЛид =
                Справочники.leads.СоздатьЭлемент();

            НовыйЛид.ОбменДанными.Загрузка =
                Истина;

            НовыйЛид.lead_id =
                СтрокаДанных.lead_id;

            НовыйЛид.created_at =
                СтрокаДанных.created_at;

            НовыйЛид.source =
                СсылкаНаИсточник;

            НовыйЛид.current_stage =
                СсылкаНаСтадию;

            НовыйЛид.manager =
                СсылкаНаМенеджера;

            НовыйЛид.Наименование =
                "Лид "
                + Строка(СтрокаДанных.lead_id);

            НовыйЛид.Код =
                Число(СтрокаДанных.lead_id);

            НовыйЛид.Записать();

            КэшЛидов.Вставить(
                СтрокаДанных.lead_id,
                НовыйЛид.Ссылка
            );

        КонецЦикла;

        ЗафиксироватьТранзакцию();

    КонецЕсли;



    // =========================================================================
    // LEAD STAGES
    // =========================================================================

    Если Данные.lead_stages.Количество() > 0 Тогда

        НаборЗаписей =
            РегистрыСведений.lead_stages.СоздатьНаборЗаписей();

        Для Каждого СтрокаДанных Из Данные.lead_stages Цикл

            НайденныеЛиды =
                Справочники.leads.НайтиПоРеквизиту(
                    "lead_id",
                    СтрокаДанных.lead_id,
                    Истина
                );

            Если НайденныеЛиды =
               Справочники.leads.ПустаяСсылка() Тогда

                Продолжить;

            КонецЕсли;

            Проверка =
                РегистрыСведений.lead_stages.СоздатьНаборЗаписей();

            Проверка.Отбор.lead_id.Установить(
                НайденныеЛиды
            );

            Проверка.Отбор.stage.Установить(
                СтрокаДанных.stage
            );

            Проверка.Прочитать();

            Если Проверка.Количество() > 0 Тогда
                Продолжить;
            КонецЕсли;

            НоваяЗапись =
                НаборЗаписей.Добавить();

            НоваяЗапись.lead_id =
                НайденныеЛиды;

            НоваяЗапись.stage =
                СтрокаДанных.stage;

            НоваяЗапись.entered_at =
                СтрокаДанных.entered_at;

            НоваяЗапись.left_at =
                СтрокаДанных.left_at;

        КонецЦикла;

        НаборЗаписей.Записать(Ложь);

    КонецЕсли;



    // =========================================================================
    // CONTACTS
    // =========================================================================

    Если Данные.contacts.Количество() > 0 Тогда

        МассивLeadID = Новый Массив;

        Для Каждого Стр Из Данные.contacts Цикл
            МассивLeadID.Добавить(Стр.lead_id);
        КонецЦикла;

        КэшСсылокЛидов =
            ПолучитьКэш(
                "leads",
                "lead_id",
                МассивLeadID
            );

        КэшСуществующихКонтактов =
            ПолучитьКэшКонтактов(
                МассивLeadID
            );

        НачатьТранзакцию();

        Попытка

            Для Каждого СтрокаДанных Из Данные.contacts Цикл

                СсылкаНаЛид =
                    КэшСсылокЛидов.Получить(
                        СтрокаДанных.lead_id
                    );

                Если СсылкаНаЛид = Неопределено Тогда
                    Продолжить;
                КонецЕсли;

                КлючДубля =
                    Строка(СтрокаДанных.lead_id)
                    + "|"
                    + СтрокаДанных.full_name;

                Если КэшСуществующихКонтактов.Получить(
                       КлючДубля
                   ) <> Неопределено Тогда

                    Продолжить;

                КонецЕсли;

                НовыйКонтакт =
                    Справочники.contacts.СоздатьЭлемент();

                НовыйКонтакт.ОбменДанными.Загрузка =
                    Истина;

                НовыйКонтакт.lead_id =
                    СсылкаНаЛид;

                НовыйКонтакт.full_name =
                    СтрокаДанных.full_name;

                НовыйКонтакт.email =
                    СтрокаДанных.email;

                НовыйКонтакт.Записать();

                КэшСуществующихКонтактов.Вставить(
                    КлючДубля,
                    НовыйКонтакт.Ссылка
                );

            КонецЦикла;

            ЗафиксироватьТранзакцию();

        Исключение

            ОтменитьТранзакцию();
            ВызватьИсключение;

        КонецПопытки;

    КонецЕсли;

КонецПроцедуры


Функция ОпределитьТипФайла(МассивЗаголовков)

    Если МассивЗаголовков.Количество() = 2
       И МассивЗаголовков[0] = "code_name"
       И МассивЗаголовков[1] = "name" Тогда

        Возврат "sources";

    ИначеЕсли МассивЗаголовков.Количество() = 3
       И МассивЗаголовков[0] = "full_name"
       И МассивЗаголовков[1] = "email"
       И МассивЗаголовков[2] = "role" Тогда

        Возврат "employees";

    ИначеЕсли МассивЗаголовков.Количество() >= 5
       И МассивЗаголовков[0] = "lead_id"
       И МассивЗаголовков[1] = "created_at"
       И МассивЗаголовков[2] = "source"
       И МассивЗаголовков[3] = "current_stage"
       И МассивЗаголовков[4] = "manager" Тогда

        Возврат "leads";

    ИначеЕсли МассивЗаголовков.Количество() = 4
       И МассивЗаголовков[0] = "lead_id"
       И МассивЗаголовков[1] = "stage"
       И МассивЗаголовков[2] = "entered_at"
       И МассивЗаголовков[3] = "left_at" Тогда

        Возврат "lead_stages";

    ИначеЕсли МассивЗаголовков.Количество() = 3
       И МассивЗаголовков[0] = "lead_id"
       И МассивЗаголовков[1] = "full_name"
       И МассивЗаголовков[2] = "email" Тогда

        Возврат "contacts";

    КонецЕсли;

    Возврат Неопределено;

КонецФункции


Функция ПреобразоватьДатуИзCSV(Знач СтрДата)

    Если СтрНайти(СтрДата, ".") Тогда

        Возврат Дата(СтрДата);

    Иначе

        СтрДата =
            СтрЗаменить(СтрДата, "T", "");

        СтрДата =
            СтрЗаменить(СтрДата, "-", "");

        СтрДата =
            СтрЗаменить(СтрДата, ":", "");

        Возврат Дата(СтрДата);

    КонецЕсли;

КонецФункции



Функция ПолучитьКэш(
    ИмяСправочника,
    ИмяРеквизита,
    МассивЗначений
)

    Результат = Новый Соответствие;

    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("Значение");

    Для Каждого ТекЗнач Из МассивЗначений Цикл
        ТЗ.Добавить().Значение = ТекЗнач;
    КонецЦикла;

    ТЗ.Свернуть("Значение");

    ЧистыйМассив =
        ТЗ.ВыгрузитьКолонку("Значение");

    Запрос = Новый Запрос;

    Запрос.Текст =
        "ВЫБРАТЬ
        |   Т.Ссылка КАК Ссылка,
        |   Т." + ИмяРеквизита + " КАК Ключ
        |ИЗ
        |   Справочник." + ИмяСправочника + " КАК Т
        |ГДЕ
        |   Т." + ИмяРеквизита + " В (&МассивЗначений)";

    Запрос.УстановитьПараметр(
        "МассивЗначений",
        ЧистыйМассив
    );

    Выборка =
        Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        Результат.Вставить(
            Выборка.Ключ,
            Выборка.Ссылка
        );

    КонецЦикла;

    Возврат Результат;

КонецФункции



Функция ПолучитьКэшКонтактов(МассивLeadID)

    Результат = Новый Соответствие;

    Запрос = Новый Запрос;

    Запрос.Текст =
        "ВЫБРАТЬ
        |   Т.Ссылка,
        |   Т.lead_id КАК lead_id,
        |   Т.full_name КАК full_name
        |ИЗ
        |   Справочник.contacts КАК Т
        |ГДЕ
        |   Т.lead_id В (&МассивLeadID)";

    Запрос.УстановитьПараметр("МассивLeadID",МассивLeadID);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        Ключ = Строка(Выборка.lead_id) + "|" + Выборка.full_name;

        Результат.Вставить(Ключ,Выборка.Ссылка);

    КонецЦикла;

    Возврат Результат;

КонецФункции



//для go

Функция ImportPOST(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
    Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");

    // Читаем чистый CSV с фронта
    CSVТекст = Запрос.ПолучитьТелоКакСтроку("UTF-8");
    Если ПустаяСтрока(CSVТекст) Тогда
        Ответ.КодСостояния = 400;
        Ответ.УстановитьТелоИзСтроки("{""error"":""Файл пуст или не получен""}");
        Возврат Ответ;
    КонецЕсли;

    // Простой парсинг
    МассивСтрок = СтрРазделить(CSVТекст, Символы.ПС, Ложь);
    МассивЛидов = Новый Массив;
    
    Для Каждого СтрокаТекста Из МассивСтрок Цикл
        СтрокаТекста = СокрЛП(СтрокаТекста);
        // Пропускаем пустые строки и заголовки
        Если ПустаяСтрока(СтрокаТекста) Или Найти(СтрокаТекста, "full_name") > 0 Тогда
            Продолжить; 
        КонецЕсли;
        
        Разделитель = ?(Найти(СтрокаТекста, ";") > 0, ";", ",");
        Колонки = СтрРазделить(СтрокаТекста, Разделитель, Истина);
        
        Если Колонки.Количество() >= 2 Тогда
            Лид = Новый Структура;
            Лид.Вставить("full_name", СокрЛП(Колонки[0]));
            Лид.Вставить("phone", СокрЛП(Колонки[1]));
            МассивЛидов.Добавить(Лид);
        КонецЕсли;
    КонецЦикла;

    // Если 1С не нашла ни одной строки с данными — нет смысла стучаться в Go
    Если МассивЛидов.Количество() = 0 Тогда
        Ответ.КодСостояния = 400;
        Ответ.УстановитьТелоИзСтроки("{""error"":""В CSV нет данных для импорта""}");
        Возврат Ответ;
    КонецЕсли;

    // Упаковываем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ДанныеДляGo = Новый Структура("leads", МассивЛидов);
    ЗаписатьJSON(ЗаписьJSON, ДанныеДляGo);
    СтрокаJSON = ЗаписьJSON.Закрыть();

    // Стучимся в Go (используем ВызватьHTTPМетод)
    Попытка
        СоединениеGo = Новый HTTPСоединение("localhost", 8080);
        ЗапросGo = Новый HTTPЗапрос("/import/leads");
        ЗапросGo.Заголовки.Вставить("Content-Type", "application/json");
        ЗапросGo.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
        
        // Надежный вызов POST-запроса
        ОтветGo = СоединениеGo.ВызватьHTTPМетод("POST", ЗапросGo); 
        
        Ответ.КодСостояния = ОтветGo.КодСостояния;
        Ответ.УстановитьТелоИзСтроки(ОтветGo.ПолучитьТелоКакСтроку("UTF-8"));
    Исключение
        Ответ.КодСостояния = 500;
        Ответ.УстановитьТелоИзСтроки("{""error"":""Ошибка соединения 1С -> Go: " + ОписаниеОшибки() + """}");
    КонецПопытки;

    Возврат Ответ;
КонецФункции

Функция ImportOPTIONS(Запрос) Экспорт // Слово Экспорт обязательно!
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
    Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, PATCH, OPTIONS");
    Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization");
    Возврат Ответ;
КонецФункции