Функция РассчитатьВоронку(Начало, Конец, СсылкаНаМенеджера) Экспорт
    Запрос = Новый Запрос;
    ТекстЗапроса = 
    "ВЫБРАТЬ
   |   ЕСТЬNULL(
   |        СУММА(ВЫБОР КОГДА lead_stages.stage = ""new"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ),
   |        0
   |    ) КАК cntNew,

   |   ЕСТЬNULL(
   |        СУММА(ВЫБОР КОГДА lead_stages.stage = ""qualified"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ),
   |        0
   |    ) КАК cntQualified,

   |    ЕСТЬNULL(
   |        СУММА(ВЫБОР КОГДА lead_stages.stage = ""proposal"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ),
   |        0
   |    ) КАК cntProposal,

   |    ЕСТЬNULL(
   |        СУММА(ВЫБОР КОГДА lead_stages.stage = ""won"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ),
   |        0
   |    ) КАК cntWon,

   |    ЕСТЬNULL(
   |        СУММА(ВЫБОР КОГДА lead_stages.stage = ""lost"" ТОГДА 1 ИНАЧЕ 0 КОНЕЦ),
   |        0
   |    ) КАК cntLost
   |ИЗ
   |    РегистрСведений.lead_stages КАК lead_stages
   |ГДЕ
   |   1=1";
	
	Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Конец) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at МЕЖДУ &Начало И &Конец";
		Запрос.УстановитьПараметр("Начало", Начало);
    	Запрос.УстановитьПараметр("Конец", Конец);
	ИначеЕсли ЗначениеЗаполнено(Начало) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at >= &Начало";
		Запрос.УстановитьПараметр("Начало", Начало);
	ИначеЕсли ЗначениеЗаполнено(Конец) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at <= &Конец";
		Запрос.УстановитьПараметр("Конец", Конец);
	КонецЕсли;
	Если ЗначениеЗаполнено(СсылкаНаМенеджера) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.manager = &СсылкаНаМенеджера";
		Запрос.УстановитьПараметр("СсылкаНаМенеджера", СсылкаНаМенеджера);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
    
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    
    Данные = Новый Структура("NewPercent, QualifiedPercent, ProposalPercent, WonPercent, LostPercent", 100, 0, 0, 0, 0);
    
	Если Выборка.cntNew > 0 Тогда
	    Данные.QualifiedPercent = (Выборка.cntQualified * 100.0) / Выборка.cntNew;
	    Данные.ProposalPercent  = (Выборка.cntProposal * 100.0) / Выборка.cntNew;
	    Данные.WonPercent       = (Выборка.cntWon * 100.0) / Выборка.cntNew;
	    Данные.LostPercent      = (Выборка.cntLost * 100.0) / Выборка.cntNew;
    КонецЕсли;
    
    Возврат Данные;
КонецФункции


Функция РассчитатьКонверсиюKPI(Начало, Конец, СсылкаНаМенеджера) Экспорт
    Запрос = Новый Запрос;
    
    // Базовая часть запроса
    ТекстЗапроса = 
    "ВЫБРАТЬ

    |   lead_stages.stage КАК stage,
    |   КОЛИЧЕСТВО(*) КАК ВсегоНаСтадии,
    |   СУММА(ВЫБОР КОГДА lead_stages.left_at <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЗавершилиСтадию

    |ИЗ
    |   РегистрСведений.lead_stages КАК lead_stages
    |ГДЕ

    |   1=1";

    // Динамическое добавление фильтров по датам
    Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Конец) Тогда
        ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at МЕЖДУ &Начало И &Конец";
        Запрос.УстановитьПараметр("Начало", Начало);
        Запрос.УстановитьПараметр("Конец", Конец);
    ИначеЕсли ЗначениеЗаполнено(Начало) Тогда
        ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at >= &Начало";
        Запрос.УстановитьПараметр("Начало", Начало);
    ИначеЕсли ЗначениеЗаполнено(Конец) Тогда
        ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at <= &Конец";
        Запрос.УстановитьПараметр("Конец", Конец);
    КонецЕсли;

    // Фильтр по менеджеру
    Если ЗначениеЗаполнено(СсылкаНаМенеджера) Тогда
        ТекстЗапроса = ТекстЗапроса + " И lead_stages.manager = &СсылкаНаМенеджера";
        Запрос.УстановитьПараметр("СсылкаНаМенеджера", СсылкаНаМенеджера);
    КонецЕсли;

    // Завершаем запрос группировкой
    Запрос.Текст = ТекстЗапроса + "
    |СГРУППИРОВАТЬ ПО 
    |   lead_stages.stage";
    
    ТЗ = Запрос.Выполнить().Выгрузить();
    
    // Инициализация структур данных
    Статистика = Новый Структура("new, qualified, proposal, won, lost", 0, 0, 0, 0, 0);
    Успех      = Новый Структура("new, qualified, proposal", 0, 0, 0);
    
    Для Каждого Стр Из ТЗ Цикл
        // Проверка на случай, если в stage пришло что-то неожиданное
        Если Статистика.Свойство(Стр.stage) Тогда
            Статистика.Вставить(Стр.stage, Стр.ВсегоНаСтадии);
        КонецЕсли;
        
        Если Стр.stage = "new" ИЛИ Стр.stage = "qualified" ИЛИ Стр.stage = "proposal" Тогда
            Успех.Вставить(Стр.stage, Стр.ЗавершилиСтадию);
        КонецЕсли;
    КонецЦикла;

    KPI_structure = Новый Структура;

    // 1. New -> Qualified 
    Если Успех.new > 0 Тогда
        Конверсия = (Статистика.qualified * 100.0) / Успех.new;
        KPI_structure.Вставить("NewToQualified", Окр(Конверсия, 3));
        KPI_structure.Вставить("NewToLost", Окр(100 - Конверсия, 3));
    Иначе
        KPI_structure.Вставить("NewToQualified", 0);
        KPI_structure.Вставить("NewToLost", 0);
    КонецЕсли;

    // 2. Qualified -> Proposal
    Если Успех.qualified > 0 Тогда
        Конверсия = (Статистика.proposal * 100.0) / Успех.qualified;
        KPI_structure.Вставить("QualifiedToProposal", Окр(Конверсия, 3));
        KPI_structure.Вставить("QualifiedToLost", Окр(100 - Конверсия, 3));
    Иначе
        KPI_structure.Вставить("QualifiedToProposal", 0);
        KPI_structure.Вставить("QualifiedToLost", 0);
    КонецЕсли;

    // 3. Proposal -> Won (Конверсия продаж)
    Если Успех.proposal > 0 Тогда
        Конверсия = (Статистика.won * 100.0) / Успех.proposal;
        KPI_structure.Вставить("ProposalToWon", Окр(Конверсия, 3));
        KPI_structure.Вставить("ProposalToLost", Окр(100 - Конверсия, 3));
    Иначе
        KPI_structure.Вставить("ProposalToWon", 0);
        KPI_structure.Вставить("ProposalToLost", 0);
    КонецЕсли;

    Возврат KPI_structure;
КонецФункции



Функция РассчитатьДлительностьСтадий(Начало, Конец, СсылкаНаМенеджера) Экспорт
	
	Запрос = Новый Запрос;
	
	// Базовый текст с обязательным фильтром по заполненной дате выхода
	ТекстЗапроса = 
	"ВЫБРАТЬ

	|	lead_stages.stage КАК stage,
	|	СРЕДНЕЕ(РАЗНОСТЬДАТ(lead_stages.entered_at, lead_stages.left_at, ЧАС)) КАК AvgDurationHour
	|ИЗ

	|	РегистрСведений.lead_stages КАК lead_stages
	|ГДЕ
	|	lead_stages.left_at <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";

	// Обработка фильтров по Началу
	Если ЗначениеЗаполнено(Начало) Тогда
		ТекстЗапроса = ТекстЗапроса + " 

		|	И lead_stages.entered_at >= &Начало 
		|	И lead_stages.left_at >= &Начало";
		Запрос.УстановитьПараметр("Начало", Начало);
	КонецЕсли;

	// Обработка фильтров по Концу
	Если ЗначениеЗаполнено(Конец) Тогда
		ТекстЗапроса = ТекстЗапроса + " 

		|	И lead_stages.entered_at <= &Конец 
		|	И lead_stages.left_at <= &Конец";
		Запрос.УстановитьПараметр("Конец", Конец);
	КонецЕсли;

	// Фильтр по менеджеру
	Если ЗначениеЗаполнено(СсылкаНаМенеджера) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.manager = &СсылкаНаМенеджера";
		Запрос.УстановитьПараметр("СсылкаНаМенеджера", СсылкаНаМенеджера);
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса + "

	|СГРУППИРОВАТЬ ПО
	|	lead_stages.stage";

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Длительность = Новый Структура("new, qualified, proposal", 0, 0, 0);
	
	Для Каждого Стр Из РезультатЗапроса Цикл
		ИмяСтадии = НРег(Стр.stage);
		Если Длительность.Свойство(ИмяСтадии) Тогда
			// Используем ЕСТЬNULL на случай, если СРЕДНЕЕ вернет NULL
			ЗначениеВЧасах = Окр(?(Стр.AvgDurationHour = NULL, 0, Стр.AvgDurationHour), 1);
			Длительность.Вставить(ИмяСтадии, ЗначениеВЧасах);
		КонецЕсли;
	КонецЦикла;

	Возврат Длительность;
	
КонецФункции

