Функция ReportGetAllData(Запрос) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Попытка
			
	    НачалоСтр = Запрос.ПараметрыЗапроса["start"];
		КонецСтр = Запрос.ПараметрыЗапроса["end"];
		manager = Запрос.ПараметрыЗапроса["manager"];
		Токен = Запрос.Заголовки.Получить("token");
		
		Сотрудник = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Если Сотрудник.Пустая() Тогда
			Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Проблема с токеном")
		КонецЕсли;
		
		
		//Поддерживает 2023-10-25T14:30:00   2023-10-25   2023-10-25 14:30:00
		Начало = Неопределено;
	    Если ЗначениеЗаполнено(НачалоСтр) Тогда
	        Попытка
	            Начало = XMLЗначение(Тип("Дата"), НачалоСтр);
	        Исключение
	            Возврат СформироватьОшибку(400, "INVALID_REQUEST", "Invalid date format for Start.");
	        КонецПопытки;
		КонецЕсли;
		Конец = Неопределено;
	    Если ЗначениеЗаполнено(КонецСтр) Тогда
	        Попытка
	            Конец = XMLЗначение(Тип("Дата"), КонецСтр);
	        Исключение
	            Возврат СформироватьОшибку(400, "INVALID_REQUEST", "Invalid date format for End.");
	        КонецПопытки;
	    КонецЕсли;
		Если Сотрудник.role = Перечисления.Роли.manager Тогда
			СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Иначе
			СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("full_name", manager);
		КонецЕсли;
		// 2. Вызываем функции из Общего модуля
		Попытка
			Воронка   = KPI.РассчитатьВоронку(Начало, Конец, СсылкаНаМенеджера);
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось рассчитать Воронку");
		КонецПопытки;  
		Попытка
			Конверсия = KPI.РассчитатьКонверсиюKPI(Начало, Конец, СсылкаНаМенеджера);
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось рассчитать Конверсию");
		КонецПопытки;
		Попытка
			СредняяДлительность = KPI.РассчитатьДлительностьСтадий(Начало, Конец, СсылкаНаМенеджера);
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось рассчитать Длительность");
		КонецПопытки;
			
		
		// 3. Собираем финальную структуру для ответа
		ОбщиеДанные = Новый Структура;
		ОбщиеДанные.Вставить("period", Новый Структура("from, to", Начало, Конец));
		ОбщиеДанные.Вставить("funnel", Воронка);
		ОбщиеДанные.Вставить("kpi",    Конверсия);
		ОбщиеДанные.Вставить("avgtime", СредняяДлительность);

		// 4. Сериализация в JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ОбщиеДанные);
		СтрокаJSON = ЗаписьJSON.Закрыть();
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки())
	КонецПопытки;

	// 5. Формируем ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);

	Возврат Ответ;
	
КонецФункции

Функция Register(Запрос) Экспорт

    Ответ = Новый HTTPСервисОтвет(201);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);	

		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина); 
		ЧтениеJSON.Закрыть();
		
		full_name = ДанныеЗапроса.Получить("full_name");
		email = ДанныеЗапроса.Получить("email");
		role = ДанныеЗапроса.Получить("role");
		password = ДанныеЗапроса.Получить("password");
		
		Если НЕ ЗначениеЗаполнено(full_name) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "Full_name is required");
		ИначеЕсли НЕ ЗначениеЗаполнено(email) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "email is required");
		ИначеЕсли НЕ ЗначениеЗаполнено(role) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "role is required");
		ИначеЕсли НЕ ЗначениеЗаполнено(password) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "password is required");
		КонецЕсли;
		
		// --- Валидация ---
		ДопустимыеРоли = Новый Массив;
		ДопустимыеРоли.Добавить("manager");
		ДопустимыеРоли.Добавить("head");
		ДопустимыеРоли.Добавить("admin");

	    Если ЗначениеЗаполнено(role) И ДопустимыеРоли.Найти(role) = Неопределено Тогда 
	        Возврат СформироватьОшибку(400, "INVALID FILTER", "Invalid value for 'role'. Try manager, head or admin");        
		КонецЕсли;
		
		Если НЕ ПроверитьФорматEmail(email) Тогда
			Возврат СформироватьОшибку(400, "INVALID_EMAIL", "Неверный email");
		КонецЕсли;

	    // ──── Проверка уникальности ────
	    Запрос = Новый Запрос;
	    Запрос.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1 
		 |   employees.Ссылка КАК Ссылка 
		 |ИЗ
		 |   Справочник.employees КАК employees
	     |ГДЕ 
		 |   employees.email = &email";
	    Запрос.УстановитьПараметр("email", email);

	    Если НЕ Запрос.Выполнить().Пустой() Тогда
	        Возврат СформироватьОшибку(409, "CONFLICT", "Пользователь с таким email уже существует");
	    КонецЕсли;

	    // ──── Создание пользователя ────
		Попытка
		    Соль = Строка(Новый УникальныйИдентификатор);
			Токен = Строка(Новый УникальныйИдентификатор);
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось сгенерировать токен");
		КонецПопытки;
		Попытка	
		    ХешПароля = ЗашифроватьSHA1ШтатнымиСредствами(password, Соль);
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось сгенерировать хеш пароля");
		КонецПопытки;
		
	    Попытка
		    НовыйПользователь = Справочники.employees.СоздатьЭлемент();
			НовыйПользователь.Наименование = email;
			НовыйПользователь.full_name = full_name;
		    НовыйПользователь.email = email;
			НовыйПользователь.role = Перечисления.Роли[role];
		    НовыйПользователь.ХешПароля = ХешПароля;
		    НовыйПользователь.Соль = Соль;
			НовыйПользователь.Токен = Токен;
		    НовыйПользователь.Записать();
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Не удалось зарегистрировать пользователя");
		КонецПопытки;
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки())
	КонецПопытки;

    
    ОтветJSON = Новый Структура;
    ОтветJSON.Вставить("token", Токен);
    Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
    Возврат Ответ;

КонецФункции

Функция Login(Запрос) Экспорт

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Попытка
		
	    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);	

		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина); 
		ЧтениеJSON.Закрыть();
		
		email = ДанныеЗапроса.Получить("email");
		password = ДанныеЗапроса.Получить("password");
		
		Если НЕ ЗначениеЗаполнено(password) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "password is required");
		ИначеЕсли НЕ ЗначениеЗаполнено(email) Тогда
	        Возврат СформироватьОшибку(400, "INVALID_REQUEST", "email is required");
		КонецЕсли;
		
		Если НЕ ПроверитьФорматEmail(email) Тогда
			Возврат СформироватьОшибку(400, "INVALID_EMAIL", "Неверный email");
		КонецЕсли;
		
	    // ──── Поиск пользователя ────
	    Запрос = Новый Запрос;
	    Запрос.Текст =
	    "ВЫБРАТЬ ПЕРВЫЕ 1 
		 |   employees.Ссылка КАК Ссылка,
		 |   employees.Соль КАК Соль,
		 |   employees.ХешПароля КАК ХешПароля,
		 |   employees.Токен КАК Токен
		 |ИЗ
		 |   Справочник.employees КАК employees
	     |ГДЕ 
		 |   employees.email = &email";
	    Запрос.УстановитьПараметр("email", email);

	    Результат = Запрос.Выполнить();
	    Если Результат.Пустой() Тогда
	        Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Неверный email");
	    КонецЕсли;

	    Выборка = Результат.Выбрать();
	    Выборка.Следующий();

	    // ──── Проверка пароля ────
	    ХешВведенного = ЗашифроватьSHA1ШтатнымиСредствами(password, Выборка.Соль);
	    Если ХешВведенного <> СокрЛП(Выборка.ХешПароля) Тогда
	        Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Неверный пароль");
		КонецЕсли;
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки())
	КонецПопытки;

    ОтветJSON = Новый Структура;
    ОтветJSON.Вставить("message", "Авторизация прошла успешно");
	ОтветJSON.Вставить("token", Выборка.Токен);
    Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
    Возврат Ответ;

КонецФункции

Функция ImportImport(Запрос) Экспорт

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); 
    
    Попытка
        // ЧИТАЕМ СТРОГО В UTF-8, ЧТОБЫ ИЗБЕЖАТЬ КРАКОЗЯБР!
        ТекстCSV = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        
        // Получаем разобранные данные и тип (leads, sources и т.д.)
        РезультатИмпорта = ИмпортCSV.ИмпортироватьCSV(ТекстCSV);
        ТипДанных = РезультатИмпорта.ТипДанных;
        МассивДанных = РезультатИмпорта.МассивДанных;
        
        Если ПустаяСтрока(ТипДанных) Тогда
            ВызватьИсключение "Не удалось определить тип файла или файл пуст.";
        КонецЕсли;
        
        // Упаковываем массив в структуру. Ключ совпадает с типом (например, "sources": [...])
        ДанныеДляБэка = Новый Структура;
        ДанныеДляБэка.Вставить(ТипДанных, МассивДанных); 
        
        // Настройка подключения к Go
        СерверБэка = "localhost"; 
        ПортБэка   = 8080;
        
        СоединениеБэк = Новый HTTPСоединение(СерверБэка, ПортБэка);
        
        // ДИНАМИЧЕСКИЙ URL! Если sources, отправит на /import/sources
        ЗапросБэк     = Новый HTTPЗапрос("/import/" + ТипДанных);
        ЗапросБэк.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ДанныеДляБэка);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        ЗапросБэк.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
        
        ОтветБэка = СоединениеБэк.ВызватьHTTPМетод("POST", ЗапросБэк);
        
        Если ОтветБэка.КодСостояния < 200 Или ОтветБэка.КодСостояния >= 300 Тогда
            ВызватьИсключение "Бэкенд вернул ошибку: " + ОтветБэка.КодСостояния + " " + ОтветБэка.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        КонецЕсли;
        
    Исключение
        Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки());
    КонецПопытки;
    
    ОтветJSON = Новый Структура;
    ОтветJSON.Вставить("success", "Импорт " + ТипДанных + " прошел успешно, данные переданы на бэкенд."); 
    
    ЗаписьОтвета = Новый ЗаписьJSON;
    ЗаписьОтвета.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьОтвета, ОтветJSON);
    
    Ответ.УстановитьТелоИзСтроки(ЗаписьОтвета.Закрыть());
    Возврат Ответ;

КонецФункции



