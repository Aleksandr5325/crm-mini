		КонецПопытки;
		
		// --- ОБНОВЛЕНИЕ КОНТАКТА ---
		ЛидОбъект2 = Справочники.contacts.НайтиПоРеквизиту("lead_id", ЛидСсылка).ПолучитьОбъект();
		Если ЛидОбъект2 <> Неопределено Тогда
