Функция LeadsListLeads(Запрос) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Попытка
	
		source = Запрос.ПараметрыЗапроса["source"];
		stage = Запрос.ПараметрыЗапроса["current_stage"];
		manager = Запрос.ПараметрыЗапроса["manager"]; // Теперь сюда ожидаем email
		Токен = Запрос.Заголовки.Получить("token");
		
		Сотрудник = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Если Сотрудник.Пустая() Тогда
			Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Проблема с токеном")
		КонецЕсли;

		// --- Валидация ---
		ДопустимыеСтадии = Новый Массив;
		ДопустимыеСтадии.Добавить("new");
		ДопустимыеСтадии.Добавить("qualified");
		ДопустимыеСтадии.Добавить("proposal");
		ДопустимыеСтадии.Добавить("won");
		ДопустимыеСтадии.Добавить("lost");

        Если ЗначениеЗаполнено(stage) И ДопустимыеСтадии.Найти(stage) = Неопределено Тогда 
            Возврат СформироватьОшибку(400, "INVALID FILTER", "Invalid value for 'stage'");        
		КонецЕсли;
		
		СсылкаНаМенеджера = Неопределено;
		Если ЗначениеЗаполнено(manager) Тогда			
            // ИЗМЕНЕНИЕ: Ищем по email
			СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("email", manager);			
			Если СсылкаНаМенеджера.Пустая() Тогда
				Возврат СформироватьОшибку(404, "NOT_FOUND", "Manager not found");
			КонецЕсли;		
		КонецЕсли;
		
		СсылкаНаИсточник = Неопределено;
		Если ЗначениеЗаполнено(source) Тогда			
			СсылкаНаИсточник = Справочники.sources.НайтиПоРеквизиту("code_name", source);			
			Если СсылкаНаИсточник.Пустая() Тогда
				Возврат СформироватьОшибку(404, "NOT_FOUND", "Source not found");
			КонецЕсли;		
		КонецЕсли;

        // --- Формируем запрос ---
        ЗапросКБазе = Новый Запрос;
		
        ТекстЗапроса = 
        "ВЫБРАТЬ
         |   leads.lead_id КАК lead_id,
         |   leads.created_at КАК created_at,
         |   leads.source КАК source,
         |   leads.current_stage КАК current_stage,
         |   leads.manager КАК manager,
		 |   leads.note КАК note
         |ИЗ
         |   Справочник.leads КАК leads
         |ГДЕ 1=1";

        // --- Фильтры ---
		Если ЗначениеЗаполнено(stage) Тогда		
			СсылкаНаСтадию = Неопределено;
			Если stage = "new" Тогда
				СсылкаНаСтадию=Перечисления.Стадии.new;
			ИначеЕсли stage = "qualified" Тогда
				СсылкаНаСтадию=Перечисления.Стадии.qualified;
			ИначеЕсли stage = "proposal" Тогда
				СсылкаНаСтадию=Перечисления.Стадии.proposal;
			ИначеЕсли stage = "won" Тогда
				СсылкаНаСтадию=Перечисления.Стадии.won;
			ИначеЕсли stage = "lost" Тогда
				СсылкаНаСтадию=Перечисления.Стадии.lost;
			КонецЕсли;
			Если НЕ СсылкаНаСтадию.Пустая() Тогда
                ТекстЗапроса = ТекстЗапроса + " И leads.current_stage = &stage";
                ЗапросКБазе.УстановитьПараметр("stage", СсылкаНаСтадию);
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			Если Сотрудник.role = Перечисления.Роли.manager Тогда
				ТекстЗапроса = ТекстЗапроса + " И leads.manager = &manager";
                ЗапросКБазе.УстановитьПараметр("manager", Сотрудник);
			Иначе
				Если ЗначениеЗаполнено(manager) Тогда		
                    // ИЗМЕНЕНИЕ: Ищем по email
					СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("email", manager);	
                    ТекстЗапроса = ТекстЗапроса + " И leads.manager = &manager";
                    ЗапросКБазе.УстановитьПараметр("manager", СсылкаНаМенеджера); 
				КонецЕсли;
			КонецЕсли;
		Исключение
			Возврат СформироватьОшибку(500, "SERVER_ERROR", "Ошибка во внутреннем запросе");
		КонецПопытки;

		Если ЗначениеЗаполнено(source) Тогда		
			СсылкаНаИсточник = Справочники.sources.НайтиПоРеквизиту("code_name", source);
            ТекстЗапроса = ТекстЗапроса + " И leads.source = &source";
            ЗапросКБазе.УстановитьПараметр("source", СсылкаНаИсточник);
		КонецЕсли;
		
        ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО
		|   leads.lead_id";
        ЗапросКБазе.Текст = ТекстЗапроса;
        Выборка = ЗапросКБазе.Выполнить().Выбрать();

        // --- Формируем JSON ---
        МассивЛидов = Новый Массив;

        Пока Выборка.Следующий() Цикл
            
            Лид = Новый Структура;
            Лид.Вставить("lead_id", Строка(Выборка.lead_id));
            Лид.Вставить("created_at", Формат(Выборка.created_at, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            Лид.Вставить("source", Строка(Выборка.source));
            Лид.Вставить("current_stage", Строка(Выборка.current_stage));
            // Возвращаем email менеджера или его имя? Обычно фронт хочет email как ID
            Лид.Вставить("manager", Строка(Сотрудник.email)); 
			Лид.Вставить("note", Строка(Выборка.note));
            
            МассивЛидов.Добавить(Лид);
            
		КонецЦикла;
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки())
	КонецПопытки;

    ОтветJSON = Новый Структура;
    ОтветJSON.Вставить("leads", МассивЛидов);

    // --- Отправка ответа ---
    Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
	Возврат Ответ;

КонецФункции

Функция LeadGetLead(Запрос) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Попытка
		
		userID = Запрос.ПараметрыURL.Получить("id");
		userID = СокрЛП(userID);
		userID = Число(userID); 
		Токен = Запрос.Заголовки.Получить("token");
		
		Сотрудник = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Если Сотрудник.Пустая() Тогда
			Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Проблема с токеном")
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(userID) Тогда
			Возврат СформироватьОшибку(400, "INVALID_ID", "Lead id is required");
		КонецЕсли;
		
		СсылкаНаЛида = Справочники.leads.НайтиПоРеквизиту("lead_id", userID);
	    
	    ЗапросКБазе = Новый Запрос;
		
		ТекстЗапроса = 
	    "ВЫБРАТЬ
	     |   leads.lead_id КАК lead_id,
	     |   leads.created_at КАК created_at,
	     |   leads.source КАК source,
	     |   leads.current_stage КАК current_stage,
	     |   leads.manager КАК manager,
		 |   leads.note КАК note
	     |ИЗ
	     |   Справочник.leads КАК leads
	     |ГДЕ 
		 |   leads.lead_id = &lead_id";
		
		Если Сотрудник.role = Перечисления.Роли.manager Тогда
			ТекстЗапроса = ТекстЗапроса + " И leads.manager = &manager";
			ЗапросКБазе.УстановитьПараметр("manager", Сотрудник);
		КонецЕсли;
		ЗапросКБазе.УстановитьПараметр("lead_id", userID);
		
		ЗапросКБазе.Текст = ТекстЗапроса;
	    РезультатЗапроса = ЗапросКБазе.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат СформироватьОшибку(404, "NOT_FOUND", "Lead not found");
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ЗапросКБазе2 = Новый Запрос;
			
		ТекстЗапроса2 = 
	    "ВЫБРАТЬ
	     |   contacts.full_name КАК full_name,
	     |   contacts.email КАК email
	     |ИЗ
	     |   Справочник.contacts КАК contacts
	     |ГДЕ contacts.lead_id = &lead_id";
		ЗапросКБазе2.УстановитьПараметр("lead_id", СсылкаНаЛида);
		
		ЗапросКБазе2.Текст = ТекстЗапроса2;
	    РезультатЗапроса2 = ЗапросКБазе2.Выполнить();
		
		Если РезультатЗапроса2.Пустой() Тогда
			Возврат СформироватьОшибку(404, "NOT_FOUND", "Contact not found");
		КонецЕсли;
		
		Выборка2 = РезультатЗапроса2.Выбрать();
		Выборка2.Следующий();
			
		Если Сотрудник.role <> Перечисления.Роли.manager Тогда

		
			Лид = Новый Структура;
		    Лид.Вставить("lead_id", Строка(Выборка.lead_id));
		    Лид.Вставить("created_at", Формат(Выборка.created_at, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		    Лид.Вставить("source", Строка(Выборка.source));
		    Лид.Вставить("current_stage", Строка(Выборка.current_stage));
			Лид.Вставить("full_name", Строка(Выборка2.full_name));
			Лид.Вставить("email", Строка(Выборка2.email));
		    Лид.Вставить("manager", Строка(Выборка.manager));
			Лид.Вставить("note", Строка(Выборка.note));
		Иначе
			Лид = Новый Структура;
		    Лид.Вставить("lead_id", Строка(Выборка.lead_id));
		    Лид.Вставить("created_at", Формат(Выборка.created_at, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		    Лид.Вставить("source", Строка(Выборка.source));
		    Лид.Вставить("current_stage", Строка(Выборка.current_stage));
			Лид.Вставить("full_name", Строка(Выборка2.full_name));
