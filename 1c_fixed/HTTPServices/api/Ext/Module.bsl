Функция LeadDeleteLead(Запрос) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Попытка
		
		userID = Запрос.ПараметрыURL.Получить("id");
		userID = СокрЛП(userID);
		Попытка
	        userID = Число(userID);
	    Исключение
	        Возврат СформироватьОшибку(400, "INVALID_ID", "Lead id must be a number");
		КонецПопытки;
		
		Токен = Запрос.Заголовки.Получить("token");
		
		Сотрудник = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Если Сотрудник.Пустая() Тогда
			Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Проблема с токеном")
		КонецЕсли;
		
		Если Сотрудник.role = Перечисления.Роли.admin Тогда

		
			Если НЕ ЗначениеЗаполнено(userID) Тогда
				Возврат СформироватьОшибку(400, "INVALID_ID", "Lead id is required");
			КонецЕсли;
			
			
			ЛидСсылка = Справочники.leads.НайтиПоРеквизиту("lead_id", userID);

		    Если ЛидСсылка.Пустая() Тогда
		        Возврат СформироватьОшибку(404, "NOT_FOUND", "Lead not found");
			КонецЕсли;
			
			//Удаление
			Попытка
				//Удаляем записи регистра сведений
				НаборЗаписей = РегистрыСведений.lead_stages.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.lead_id.Установить(ЛидСсылка);
				НаборЗаписей.Прочитать();

				Если НаборЗаписей.Количество() > 0 Тогда
				    НаборЗаписей.Очистить();
				    НаборЗаписей.Записать();
				КонецЕсли;


				//Удаляем контакты
				ВыборкаКонтактов = Справочники.contacts.Выбрать();

