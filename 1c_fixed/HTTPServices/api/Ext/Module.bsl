				Возврат СформироватьОшибку(500, "ERROR", "Не получилось записать contact");
			КонецПопытки;
		КонецЕсли;

	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки())
	КонецПопытки;
	
	ОтветJSON = Новый Структура;
	ОтветJSON.Вставить("message", "Lead updated successfully");
	Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
	Возврат Ответ;
	
КонецФункции

