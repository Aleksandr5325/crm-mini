				            ВыборкаКонтактов.ПолучитьОбъект().Удалить();
				        Исключение
				            Возврат СформироватьОшибку(409, "DELETE_CONFLICT", "Cannot delete contact");
				        КонецПопытки;
				    КонецЕсли;
				КонецЦикла;
				ЛидСсылка.ПолучитьОбъект().Удалить();
			Исключение
				Возврат СформироватьОшибку(500, "SERVER_ERROR", "Незивестная ошибка");
			КонецПопытки;
		Иначе
			Возврат СформироватьОшибку(403, "FORBIDDEN", "Недостаточно прав");
		КонецЕсли;
