Функция LeadPostLead(Запрос) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Content-Type", "application/json");

	Попытка
		// 1. Читаем JSON в Соответствие
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);	
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина); 
		ЧтениеJSON.Закрыть();
		
		// 2. Берем ID из URL или из тела СТРОКОЙ (без Число() и обрезок)
		СтрокаID = Запрос.ПараметрыURL.Получить("id");
		Если Не ЗначениеЗаполнено(СтрокаID) Тогда
			СтрокаID = ДанныеЗапроса.Получить("lead_id");
		КонецЕсли;
		СтрокаID = СокрЛП(СтрокаID); // Теперь здесь остается "228" или "LEAD-003" как строка
		
		НоваяСтадия = СокрЛП(ДанныеЗапроса.Получить("current_stage"));

		// 3. Ищем лид в базе по строковому значению реквизита lead_id
		ЛидСсылка = Справочники.leads.НайтиПоРеквизиту("lead_id", СтрокаID);
		
		Если ЛидСсылка.Пустая() Тогда
			Возврат СформироватьОшибку(404, "NOT_FOUND", "Lead with string ID '" + СтрокаID + "' not found in 1C");
		КонецЕсли;

		// 4. Получаем объект и присваиваем стадию
		ЛидОбъект = ЛидСсылка.ПолучитьОбъект();
		
		Если НоваяСтадия = "new" Тогда
			ЛидОбъект.current_stage = Перечисления.Стадии.new;
		ИначеЕсли НоваяСтадия = "qualified" Тогда
			ЛидОбъект.current_stage = Перечисления.Стадии.qualified;
		ИначеЕсли НоваяСтадия = "proposal" Тогда
			ЛидОбъект.current_stage = Перечисления.Стадии.proposal;
		ИначеЕсли НоваяСтадия = "won" Тогда
			ЛидОбъект.current_stage = Перечисления.Стадии.won;
		ИначеЕсли НоваяСтадия = "lost" Тогда
			ЛидОбъект.current_stage = Перечисления.Стадии.lost;
		Иначе
			Возврат СформироватьОшибку(400, "INVALID_FILTER", "Invalid stage: " + НоваяСтадия);
		КонецЕсли;

		// 5. Обход внутренних проверок справочника
		ЛидОбъект.ОбменДанными.Загрузка = Истина;

		// 6. Записываем в базу
		Попытка
			ЛидОбъект.Записать();
		Исключение
			Возврат СформироватьОшибку(400, "SAVE_ERROR", "Ошибка записи: " + ОписаниеОшибки());
		КонецПопытки;

		// 7. Отдаем успешный ответ
		ОтветJSON = Новый Структура;
		ОтветJSON.Вставить("status", "ok");
		ОтветJSON.Вставить("message", "Stage updated successfully in 1C");
		
		Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
		Возврат Ответ;
		
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки());
	КонецПопытки;
КонецФункции



Функция LeadOptionLead(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS, PUT, DELETE");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, token"); 
	Возврат Ответ;
КонецФункции