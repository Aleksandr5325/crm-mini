Функция StagesListStages(Запрос) Экспорт
	УстановитьПривилегированныйРежим(Истина);

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Попытка
		
		lead_id = Запрос.ПараметрыЗапроса["lead_id"];
		stage = Запрос.ПараметрыЗапроса["stage"];
		entered_at_строка = Запрос.ПараметрыЗапроса["entered_at"];
		left_at_строка = Запрос.ПараметрыЗапроса["left_at"];
		manager = Запрос.ПараметрыЗапроса["manager"];
		Токен = Запрос.Заголовки.Получить("token");
		
		Сотрудник = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		Если Сотрудник.Пустая() Тогда
			Возврат СформироватьОшибку(401, "UNAUTHORIZED", "Проблема с токеном")
		КонецЕсли;
		
		// --- Валидация ---
		ДопустимыеСтадии = Новый Массив;
		ДопустимыеСтадии.Добавить("new");
		ДопустимыеСтадии.Добавить("qualified");
		ДопустимыеСтадии.Добавить("proposal");
		ДопустимыеСтадии.Добавить("won");
		ДопустимыеСтадии.Добавить("lost");

	    Если ЗначениеЗаполнено(stage) И ДопустимыеСтадии.Найти(stage) = Неопределено Тогда 
	        Возврат СформироватьОшибку(400, "INVALID FILTER", "Invalid value for 'stage'");        
		КонецЕсли;
		
		//Поддерживает 2023-10-25T14:30:00   2023-10-25   2023-10-25 14:30:00
		entered_at = Неопределено;
	    Если ЗначениеЗаполнено(entered_at_Строка) Тогда
	        Попытка
	            entered_at = XMLЗначение(Тип("Дата"), entered_at_строка);
	        Исключение
	            Возврат СформироватьОшибку(400, "INVALID_REQUEST", "Invalid date format for entered_at");
	        КонецПопытки;
		КонецЕсли;
		left_at = Неопределено;
	    Если ЗначениеЗаполнено(left_at_Строка) Тогда
	        Попытка
	            left_at = XMLЗначение(Тип("Дата"), left_at_строка);
	        Исключение
	            Возврат СформироватьОшибку(400, "INVALID_REQUEST", "Invalid date format for left_at");
	        КонецПопытки;
		КонецЕсли;
		
		
		СсылкаНаЛида = Неопределено;
		Если ЗначениеЗаполнено(lead_id) Тогда			
			СсылкаНаЛида = Справочники.leads.НайтиПоРеквизиту("lead_id", Число(lead_id));			
			Если СсылкаНаЛида.Пустая() Тогда
				Возврат СформироватьОшибку(404, "NOT_FOUND", "Lead not found");
			КонецЕсли;		
		КонецЕсли;
		
		// --- Формируем запрос ---
	    ЗапросКБазе = Новый Запрос;
	    
	    ТекстЗапроса = 
	    "ВЫБРАТЬ
	     |   lead_stages.lead_id КАК lead_id,
	     |   lead_stages.stage КАК stage,
	     |   lead_stages.entered_at КАК entered_at,
	     |   lead_stages.left_at КАК left_at,
		 |   lead_stages.manager КАК manager
	     |ИЗ
	     |   РегистрСведений.lead_stages КАК lead_stages
	     |ГДЕ 1=1";

	    // --- Фильтры ---	
		Если ЗначениеЗаполнено(stage) Тогда			
	        ТекстЗапроса = ТекстЗапроса + " И lead_stages.stage = &stage";
	        ЗапросКБазе.УстановитьПараметр("stage", stage); 
	    КонецЕсли;

		Если ЗначениеЗаполнено(lead_id) Тогда		
			СсылкаНаЛида = Справочники.leads.НайтиПоРеквизиту("lead_id", Число(lead_id));
	        ТекстЗапроса = ТекстЗапроса + " И lead_stages.lead_id = &lead_id";
	        ЗапросКБазе.УстановитьПараметр("lead_id", СсылкаНаЛида);
		КонецЕсли;
		
		Если Сотрудник.role = Перечисления.Роли.manager Тогда
	    	СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("Токен", Токен);
		ИначеЕсли ЗначениеЗаполнено(manager) Тогда
			СсылкаНаМенеджера = Справочники.employees.НайтиПоРеквизиту("full_name", manager);
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.manager = &manager";
		ЗапросКБазе.УстановитьПараметр("manager", СсылкаНаМенеджера);
		
		Если ЗначениеЗаполнено(entered_at) Тогда
		    ТекстЗапроса = ТекстЗапроса + " И lead_stages.entered_at >= &entered_at";
		    ЗапросКБазе.УстановитьПараметр("entered_at", entered_at);
		КонецЕсли;

		Если ЗначениеЗаполнено(left_at) Тогда
		    ТекстЗапроса = ТекстЗапроса + " 

	        | И ВЫБОР 
	        |   КОГДА lead_stages.left_at = ДАТАВРЕМЯ(1, 1, 1) 
	        |   ТОГДА &ТекущаяДата 
	        |
	        |   ИНАЧЕ lead_stages.left_at 
	        | КОНЕЦ <= &left_at";
	    
		    ЗапросКБазе.УстановитьПараметр("left_at", left_at);
		    ЗапросКБазе.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО
		|   lead_stages.lead_id,
		|   lead_stages.entered_at";
	    ЗапросКБазе.Текст = ТекстЗапроса;
	    Выборка = ЗапросКБазе.Выполнить().Выбрать();
		
		//Формируем ответ
		МассивСтадий = Новый Массив;

	    Пока Выборка.Следующий() Цикл
	        
	        Стадия = Новый Структура;
	        Стадия.Вставить("lead_id", Строка(Выборка.lead_id));
			Стадия.Вставить("stage", Строка(Выборка.stage));
	        Стадия.Вставить("entered_at", Формат(Выборка.entered_at, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	        Стадия.Вставить("left_at", Формат(Выборка.left_at, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Если Сотрудник.role <> Перечисления.Роли.manager Тогда
				Стадия.Вставить("manager", Строка(Выборка.manager));
			КонецЕсли;
	        
	        МассивСтадий.Добавить(Стадия);
	        
	    КонецЦикла;

	    ОтветJSON = Новый Структура;
	    ОтветJSON.Вставить("stages", МассивСтадий);
	Исключение
		Возврат СформироватьОшибку(500, "SERVER_ERROR", ОписаниеОшибки());
	КонецПопытки;

    // --- Отправка ответа ---

    Ответ.УстановитьТелоИзСтроки(ПреобразоватьВJSON(ОтветJSON));
	Возврат Ответ;
КонецФункции
