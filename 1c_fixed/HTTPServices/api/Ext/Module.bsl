		Если ЗначениеЗаполнено(source) Тогда
			СсылкаНаИсточник = Справочники.sources.НайтиПоРеквизиту("code_name", source);
			Если СсылкаНаИсточник.Пустая() Тогда
				Возврат СформироватьОшибку(400, "INVALID_FILTER", "Source not found");
			КонецЕсли;
			ЛидОбъект.source = СсылкаНаИсточник;
		КонецЕсли;

		// --- ОБНОВЛЕНИЕ МЕНЕДЖЕРА ---
		Если ЗначениеЗаполнено(manager) Тогда
			// Ищем по имени, так как на фронтенде пока нет email-ов
