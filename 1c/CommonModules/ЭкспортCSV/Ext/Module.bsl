Процедура ВыгрузитьВCSV(ПолныйПуть, ИмяСправочника, Менеджер = Неопределено) Экспорт
    
    Разделитель = ",";
    ТаблицаЗначений = Новый ТаблицаЗначений;
    
    Если ВРег(ИмяСправочника) = "LEADS" Тогда
        ТаблицаЗначений = ПолучитьДанныеLeads(Менеджер);
    ИначеЕсли ВРег(ИмяСправочника) = "LEAD_STAGES" Тогда
        ТаблицаЗначений = ПолучитьДанныеLead_Stages(Менеджер);
    Иначе
        ВызватьИсключение "Указан некорректный тип справочника: " + ИмяСправочника;
    КонецЕсли;
    
    Текст = СоздатьДанныеCSV(ТаблицаЗначений, Разделитель);
    ЗаписатьCSV(Текст, ПолныйПуть);
    
КонецПроцедуры

 
Функция ПолучитьДанныеLeads(Менеджер)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ

		|	leads.lead_id КАК lead_id,
		|	leads.created_at КАК created_at,
		|	leads.source КАК source,
		|	leads.current_stage КАК current_stage,
		|	leads.manager КАК manager
		|ИЗ
		|	Справочник.leads КАК leads
		|ГДЕ
		|	1=1";
	
	Если ЗначениеЗаполнено(Менеджер) Тогда
		ТекстЗапроса = ТекстЗапроса + " И leads.manager = &Менеджер";
		Запрос.УстановитьПараметр("Менеджер", Менеджер);
		Запрос.Текст = ТекстЗапроса;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПолучитьДанныеLead_Stages(Менеджер)
	
	Запрос = Новый Запрос;
	
	// Запрос к виртуальной таблице СрезПоследних (обычно актуально для стадий лидов)
	// Если вам нужна вся история изменений, замените ".СрезПоследних" на простое имя регистра
	ТекстЗапроса =
		"ВЫБРАТЬ

		|	lead_stages.lead_id КАК lead_id,
		|	lead_stages.stage КАК stage,
		|	lead_stages.entered_at КАК entered_at,
		|	lead_stages.left_at КАК left_at,
		|	lead_stages.manager КАК manager
		|ИЗ
		|	РегистрСведений.lead_stages КАК lead_stages
		|ГДЕ
		|	1=1";
	
	Если ЗначениеЗаполнено(Менеджер) Тогда
		ТекстЗапроса = ТекстЗапроса + " И lead_stages.manager = &Менеджер";
		Запрос.УстановитьПараметр("Менеджер", Менеджер);
		Запрос.Текст = ТекстЗапроса;
	КонецЕсли;	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции



Функция СоздатьЗаголовкиCSV(ТаблицаЗначений, Разделитель)

    ТекстЗаголовка = "";

    Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        Если ТекстЗаголовка = "" Тогда
            ТекстЗаголовка = Колонка.Имя;
        Иначе
            ТекстЗаголовка = ТекстЗаголовка + Разделитель + Колонка.Имя;
        КонецЕсли;
    КонецЦикла;

    Возврат ТекстЗаголовка;

КонецФункции


Функция СоздатьДанныеCSV(ТаблицаЗначений,разделитель)
	Текст="";
	
	для каждого запись из ТаблицаЗначений Цикл
		если Текст="" тогда
		    Текст=СоздатьЗаголовкиCSV(ТаблицаЗначений,разделитель) + Символы.ПС;   	
		КонецЕсли;  
		Текст = Текст + запись.lead_id + разделитель + запись.created_at + разделитель + запись.source + разделитель + запись.current_stage + разделитель + запись.manager + Символы.ПС;         	
	КонецЦикла;
	Возврат текст;
КонецФункции


Процедура ЗаписатьCSV(текст,имяФайла)                 	
          кодировка = КодировкаТекста.UTF8;
          ТекстовыйФайлЗапись = Новый ЗаписьТекста(имяФайла,Кодировка);           
          ТекстовыйФайлЗапись.ЗаписатьСтроку(текст);
          ТекстовыйФайлЗапись.Закрыть();         	
КонецПроцедуры