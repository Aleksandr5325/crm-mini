Перем СтараяСтадия;
Перем ЭтоНовыйЭлемент;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    // --- Наименование ---
    Наименование = lead_id;
    Код = Число(lead_id);
    
    // Запоминаем, новый ли это элемент
    ЭтоНовыйЭлемент = ЭтоНовый();

    // --- Проверка уникальности lead_id ---
    Если ЗначениеЗаполнено(lead_id) Тогда
        
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   leads.Ссылка
        |ИЗ
        |   Справочник.leads КАК leads
        |ГДЕ
        |   leads.lead_id = &lead_id
        |   И leads.Ссылка <> &ТекущийЭлемент";
        
        Запрос.УстановитьПараметр("lead_id", lead_id);
        Запрос.УстановитьПараметр("ТекущийЭлемент", Ссылка);
        
        Если НЕ Запрос.Выполнить().Пустой() Тогда
            Сообщить("lead_id уже существует!");
            Отказ = Истина;
            Возврат;
        КонецЕсли;
        
    КонецЕсли;

    // --- Получаем старую стадию (только для существующих элементов) ---
    Если НЕ ЭтоНовыйЭлемент Тогда
        
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |   leads.current_stage КАК current_stage
        |ИЗ
        |   Справочник.leads КАК leads
        |ГДЕ
        |   leads.Ссылка = &Ссылка";

        Запрос.УстановитьПараметр("Ссылка", Ссылка);

        Выборка = Запрос.Выполнить().Выбрать();
        
        Если Выборка.Следующий() Тогда
            СтараяСтадия = Выборка.current_stage;
        КонецЕсли;

        // --- Проверка порядка стадий ---
        Если НЕ ПроверитьПереходСтадии(СтараяСтадия, current_stage) Тогда
            Сообщить("Нельзя менять стадию в обратном порядке!");
            Отказ = Истина;
            Возврат;
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

    ДатаСейчас = ТекущаяДата();
    
    // === НОВЫЙ ЭЛЕМЕНТ: просто создаём первую запись ===
    Если ЭтоНовыйЭлемент Тогда
        
        Набор = РегистрыСведений.lead_stages.СоздатьНаборЗаписей();
        Набор.Отбор.lead_id.Установить(Ссылка);
        
        Запись = Набор.Добавить();
        Запись.lead_id = Ссылка;
        Запись.stage = current_stage;
        Запись.entered_at = ?(ЗначениеЗаполнено(created_at), created_at, ДатаСейчас);
        Запись.left_at = '00010101'; // пустая дата
		Запись.manager_name = manager;
        
        Набор.Записать();
        Возврат;
        
    КонецЕсли;
    
    // === СУЩЕСТВУЮЩИЙ ЭЛЕМЕНТ ===
    
    // Если стадия не изменилась — ничего не делаем
    Если СтараяСтадия = current_stage Тогда
        Возврат;
    КонецЕсли;
    
    // --- Закрываем активную стадию ---
    Набор = РегистрыСведений.lead_stages.СоздатьНаборЗаписей();
    Набор.Отбор.lead_id.Установить(Ссылка);
    Набор.Прочитать();

    Для Каждого Стр Из Набор Цикл
        // Закрываем записи без даты выхода (активные)
        Если НЕ ЗначениеЗаполнено(Стр.left_at) Тогда
            Стр.left_at = created_at;      //ДатаСейчас - created_at
        КонецЕсли;
    КонецЦикла;
    
    // --- Добавляем новую стадию в тот же набор ---
    Новая = Набор.Добавить();
    Новая.lead_id = Ссылка;
    Новая.stage = current_stage;
    Новая.entered_at = created_at;
    Новая.left_at = '00010101'; // пустая дата
	Новая.manager_name = manager;
    
    Набор.Записать();

КонецПроцедуры

Функция ПроверитьПереходСтадии(Старая, Новая)

    Если Старая = Новая Тогда
        Возврат Истина;
    КонецЕсли;
    
    // Если старая стадия не заполнена (новый элемент) — разрешаем
    Если НЕ ЗначениеЗаполнено(Старая) Тогда
        Возврат Истина;
	КонецЕсли;
	
	// В lost можно перейти из любой стадии (кроме won)
    Если Новая = Перечисления.Стадии.lost Тогда
        Возврат Старая <> Перечисления.Стадии.won;
    КонецЕсли;

    // порядок стадий
    Если Старая = Перечисления.Стадии.new Тогда
        Возврат Новая = Перечисления.Стадии.qualified;
    КонецЕсли;

    Если Старая = Перечисления.Стадии.qualified Тогда
        Возврат Новая = Перечисления.Стадии.proposal;
    КонецЕсли;

    Если Старая = Перечисления.Стадии.proposal Тогда
        Возврат (Новая = Перечисления.Стадии.won 
             ИЛИ Новая = Перечисления.Стадии.lost);
    КонецЕсли;

    // после финала нельзя менять
    Возврат Ложь;

КонецФункции
	