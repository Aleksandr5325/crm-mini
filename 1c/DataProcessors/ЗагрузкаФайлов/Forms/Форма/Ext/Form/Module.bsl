
&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Выбор = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Выбор.Заголовок = "Выберите Файл";
	Выбор.Фильтр = "(*.csv)|*.csv";
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	Выбор.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПутьКФайлу=ВыбранныеФайлы[0];
КонецПроцедуры


&НаКлиенте
Процедура ПрочитатьФайл(ТекстCSV) //Команда
	
	// Скрываем все таблицы
	Элементы.leads.Видимость = Ложь;
	Элементы.lead_stages.Видимость = Ложь;
	Элементы.sources.Видимость = Ложь;
	Элементы.employees.Видимость = Ложь;
	Элементы.contacts.Видимость = Ложь;
	
	// Очищаем все табличные части
	Объект.leads.Очистить();
	Объект.lead_stages.Очистить();
	Объект.sources.Очистить();
	Объект.employees.Очистить();
	Объект.contacts.Очистить();
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ТекстCSV);
	
	Если Текст.КоличествоСтрок() < 2 Тогда
		Сообщить("Файл должен содержать заголовок и хотя бы одну строку данных");
		Возврат;
	КонецЕсли;
	
	// Читаем заголовок (первая строка)
	СтрокаЗаголовок = Текст.ПолучитьСтроку(1);
	МассивЗаголовков = СтрРазделить(СтрокаЗаголовок, ",", Ложь);
	// Убираем возможные пробелы
	Для Индекс = 0 По МассивЗаголовков.ВГраница() Цикл
		МассивЗаголовков[Индекс] = СокрЛП(МассивЗаголовков[Индекс]);
	КонецЦикла;
	
	// Определяем тип файла по заголовку
	ТипФайла = Неопределено;
	
	Если МассивЗаголовков.Количество() = 2 И МассивЗаголовков[0] = "code_name" И МассивЗаголовков[1] = "name" Тогда
		ТипФайла = "sources";
	ИначеЕсли МассивЗаголовков.Количество() = 3 И МассивЗаголовков[0] = "full_name" И МассивЗаголовков[1] = "email" И МассивЗаголовков[2] = "role" Тогда
		ТипФайла = "employees";
	ИначеЕсли МассивЗаголовков.Количество() = 5 И МассивЗаголовков[0] = "lead_id" И МассивЗаголовков[1] = "created_at" И МассивЗаголовков[2] = "source" И МассивЗаголовков[3] = "current_stage" И МассивЗаголовков[4] = "manager" Тогда
		ТипФайла = "leads";
	ИначеЕсли МассивЗаголовков.Количество() = 4 И МассивЗаголовков[0] = "lead_id" И МассивЗаголовков[1] = "stage" И МассивЗаголовков[2] = "entered_at" И МассивЗаголовков[3] = "left_at" Тогда
		ТипФайла = "lead_stages";
	ИначеЕсли МассивЗаголовков.Количество() = 3 И МассивЗаголовков[0] = "lead_id" И МассивЗаголовков[1] = "full_name" И МассивЗаголовков[2] = "email" Тогда
		ТипФайла = "contacts";
	КонецЕсли;
	
	Если ТипФайла = Неопределено Тогда
		Сообщить("Не удалось определить тип файла по заголовку. Проверьте структуру файла.");
		Возврат;
	КонецЕсли;
	
	// Читаем данные со 2-й строки до конца
	Для НомерСтроки = 2 По Текст.КоличествоСтрок() Цикл
		ТекущаяСтрока = Текст.ПолучитьСтроку(НомерСтроки);
		Если ПустаяСтрока(ТекущаяСтрока) Тогда
			Продолжить;
		КонецЕсли;
		МассивЭлементов = СтрРазделить(ТекущаяСтрока, ",", Ложь);
		// Ожидаем, что количество полей соответствует заголовку
		Если МассивЭлементов.Количество() <> МассивЗаголовков.Количество() Тогда
			Сообщить("Строка " + НомерСтроки + " содержит неверное количество полей. Пропущена.");
			Продолжить;
		КонецЕсли;
		
		// Обработка в зависимости от типа
		Если ТипФайла = "sources" Тогда
			НоваяСтрока = Объект.sources.Добавить();
			НоваяСтрока.code_name = СокрЛП(МассивЭлементов[0]);
			НоваяСтрока.name = СокрЛП(МассивЭлементов[1]);
			
		ИначеЕсли ТипФайла = "employees" Тогда
			НоваяСтрока = Объект.employees.Добавить();
			НоваяСтрока.full_name = СокрЛП(МассивЭлементов[0]);
			НоваяСтрока.email = СокрЛП(МассивЭлементов[1]);
			НоваяСтрока.role = СокрЛП(МассивЭлементов[2]);
			
		ИначеЕсли ТипФайла = "leads" Тогда
			НоваяСтрока = Объект.leads.Добавить();
			НоваяСтрока.lead_id = Число(СокрЛП(МассивЭлементов[0])); // lead_id число
			НоваяСтрока.created_at = ПреобразоватьДатуИзCSV(МассивЭлементов[1]);
			НоваяСтрока.source = СокрЛП(МассивЭлементов[2]);
			НоваяСтрока.current_stage = СокрЛП(МассивЭлементов[3]);
			НоваяСтрока.manager = СокрЛП(МассивЭлементов[4]); // обрати внимание: manager_name
			
		ИначеЕсли ТипФайла = "lead_stages" Тогда
			НоваяСтрока = Объект.lead_stages.Добавить();
			НоваяСтрока.lead_id = Число(СокрЛП(МассивЭлементов[0]));
			НоваяСтрока.stage = СокрЛП(МассивЭлементов[1]);
			НоваяСтрока.entered_at = ПреобразоватьДатуИзCSV(МассивЭлементов[2]);
			НоваяСтрока.left_at = ПреобразоватьДатуИзCSV(МассивЭлементов[3]);
			
		ИначеЕсли ТипФайла = "contacts" Тогда
			НоваяСтрока = Объект.contacts.Добавить();
			НоваяСтрока.lead_id = Число(СокрЛП(МассивЭлементов[0]));
			НоваяСтрока.full_name = СокрЛП(МассивЭлементов[1]);
			НоваяСтрока.email = СокрЛП(МассивЭлементов[2]);
		КонецЕсли;
		
	КонецЦикла;
	
	// Показываем соответствующую таблицу
	Если ТипФайла = "sources" Тогда
		Элементы.sources.Видимость = Истина;
	ИначеЕсли ТипФайла = "employees" Тогда
		Элементы.employees.Видимость = Истина;
	ИначеЕсли ТипФайла = "leads" Тогда
		Элементы.leads.Видимость = Истина;
	ИначеЕсли ТипФайла = "lead_stages" Тогда
		Элементы.lead_stages.Видимость = Истина;
	ИначеЕсли ТипФайла = "contacts" Тогда
		Элементы.contacts.Видимость = Истина;
	КонецЕсли;
	
	// Сортируем для удобства
	Объект.leads.Сортировать("lead_id");
	Объект.lead_stages.Сортировать("lead_id");
	Объект.sources.Сортировать("code_name");
	Объект.employees.Сортировать("full_name");
	Объект.contacts.Сортировать("lead_id");
	
	Сообщить("Загружено строк: " + (Текст.КоличествоСтрок() - 1));
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьДатуИзCSV(Знач СтрДата)
	Если СтрНайти(СтрДата, ".") Тогда
		Возврат Дата(СтрДата);
	Иначе
		СтрДата = СтрЗаменить(СтрДата, "T", "");
		СтрДата = СтрЗаменить(СтрДата, "-", "");
		СтрДата = СтрЗаменить(СтрДата, ":", "");
		Возврат Дата(СтрДата);
	КонецЕсли           
КонецФункции


&НаКлиенте
Процедура ЗаписатьФайл() //Команда
	ЗаписатьФайлНаСервере();
	//Элементы.leads.Обновить();
	//Элементы.lead_stages.Обновить();
	//Элементы.sources.Обновить();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьФайлНаСервере()

    // ----------------------------------------------------------------------
    // Запись sources
    // ----------------------------------------------------------------------
    Если Объект.sources.Количество() > 0 Тогда
        Для Каждого СтрокаДанных Из Объект.sources Цикл
            // Поиск по коду (теперь код = code_name)
            Найденный = Справочники.sources.НайтиПоКоду(СтрокаДанных.code_name);
            Если Найденный = Справочники.sources.ПустаяСсылка() Тогда
                НовыйЭл = Справочники.sources.СоздатьЭлемент();
                НовыйЭл.Код = СтрокаДанных.code_name;               // site, olymp и т.д.
                НовыйЭл.Наименование = СтрокаДанных.name;           // название из CSV
                НовыйЭл.code_name = СтрокаДанных.code_name;
                НовыйЭл.name = СтрокаДанных.name;
                НовыйЭл.Записать();
            КонецЕсли;
        КонецЦикла;
        Сообщить("Загрузка справочника Sources завершена.");

    КонецЕсли;

    // ----------------------------------------------------------------------
    // Запись employees
    // ----------------------------------------------------------------------
    Если Объект.employees.Количество() > 0 Тогда
		Для Каждого СтрокаДанных Из Объект.employees Цикл
			Попытка
	            СсылкаНаРоль = Перечисления.Роли[СтрокаДанных.role];
	        Исключение
	            СсылкаНаРоль = Перечисления.Роли.ПустаяСсылка();
	        КонецПопытки;
            // Поиск по наименованию (теперь наименование = full_name)
            Найденный = Справочники.employees.НайтиПоРеквизиту("email", СтрокаДанных.email);
            Если Найденный = Справочники.employees.ПустаяСсылка() Тогда
                НовыйЭл = Справочники.employees.СоздатьЭлемент();
                НовыйЭл.Наименование = СтрокаДанных.full_name;      // полное имя
                НовыйЭл.full_name = СтрокаДанных.full_name;
                НовыйЭл.email = СтрокаДанных.email;
                НовыйЭл.role = СсылкаНаРоль;
                НовыйЭл.Записать();
            КонецЕсли;
        КонецЦикла;
        Сообщить("Загрузка справочника Employees завершена.");
    КонецЕсли;

	// ----------------------------------------------------------------------
	// Запись leads
	// ----------------------------------------------------------------------

	Если Объект.leads.Количество() > 0 Тогда
	    
	    // 1. Собираем уникальные значения вручную из коллекции формы
		МассивLeadID = Новый Массив;
		МассивSources = Новый Массив;
		МассивManagers = Новый Массив;

		Для Каждого Стр Из Объект.leads Цикл
		    МассивLeadID.Добавить(Стр.lead_id);
		    МассивSources.Добавить(Стр.source);
		    МассивManagers.Добавить(Стр.manager);
		КонецЦикла;
	    
	    // 2. Загружаем всё, что уже есть в базе, в память (за 3 запроса)
	    КэшЛидов = ПолучитьКэш("leads", "lead_id", МассивLeadID);
	    КэшИсточников = ПолучитьКэш("sources", "Наименование", МассивSources);
	    КэшМенеджеров = ПолучитьКэш("employees", "Наименование", МассивManagers);
	    
	    НачатьТранзакцию();
	    Для Каждого СтрокаДанных Из Объект.leads Цикл
	            
	        // Проверка на дубликат (теперь мгновенно в памяти)
	        Если КэшЛидов.Получить(СтрокаДанных.lead_id) <> Неопределено Тогда
	            Продолжить;
	        КонецЕсли;

	        // --- Поиск/Создание источника ---
	        СсылкаНаИсточник = КэшИсточников.Получить(СтрокаДанных.source);

	        // --- Поиск/Создание менеджера ---
	        СсылкаНаМенеджера = КэшМенеджеров.Получить(СтрокаДанных.manager);

				
	        // --- Определение стадии ---
	        // Если в JSON приходят Имена значений (как в Конфигураторе), это работает мгновенно:
	        Попытка
	            СсылкаНаСтадию = Перечисления.Стадии[СтрокаДанных.current_stage];
	        Исключение
	            СсылкаНаСтадию = Перечисления.Стадии.ПустаяСсылка();
	        КонецПопытки;
				
	        // --- Создание лида ---
	        НовыйЛид = Справочники.leads.СоздатьЭлемент();
	        НовыйЛид.ОбменДанными.Загрузка = Истина; // Ускоряет запись, пропуская проверки
	        НовыйЛид.lead_id = СтрокаДанных.lead_id;
	        НовыйЛид.created_at = СтрокаДанных.created_at;
	        НовыйЛид.source = СсылкаНаИсточник;
	        НовыйЛид.current_stage = СсылкаНаСтадию;
	        НовыйЛид.manager = СсылкаНаМенеджера;
	        НовыйЛид.Наименование = "Лид " + Строка(СтрокаДанных.lead_id);
	        НовыйЛид.Код = Число(СтрокаДанных.lead_id);
	        НовыйЛид.Записать();

	        // Обновляем кэш лидов, чтобы не создать дубль, если в одной загрузке два одинаковых ID
	        КэшЛидов.Вставить(СтрокаДанных.lead_id, НовыйЛид.Ссылка);

	    КонецЦикла;
	        
	    ЗафиксироватьТранзакцию();

	КонецЕсли;


    	
	// ----------------------------------------------------------------------
	// Запись lead_stages (теперь регистр сведений)
	// ----------------------------------------------------------------------
	Если Объект.lead_stages.Количество() > 0 Тогда
	        
	    // Определяем тип регистра и создаем набор записей
	    // Если регистр независимый (без регистратора):
	    НаборЗаписей = РегистрыСведений.lead_stages.СоздатьНаборЗаписей();
	    
	    Для Каждого СтрокаДанных Из Объект.lead_stages Цикл
	        
	        // --- 1. Находим элемент справочника Leads по lead_id ---
	        НайденныеЛиды = Справочники.leads.НайтиПоРеквизиту("lead_id", СтрокаДанных.lead_id, Истина);
	        
	        Если НайденныеЛиды = Справочники.leads.ПустаяСсылка() Тогда
	            Сообщить("Лид с lead_id=" + СтрокаДанных.lead_id + " не найден. Стадия пропущена.");
	            Продолжить;
	        КонецЕсли;
	        
	        // --- 2. Проверяем дубликат в регистре (если нужно избежать повторов) ---
	        // Создаем отбор для проверки существования такой комбинации
	        ОтборПроверки = Новый Структура;
	        ОтборПроверки.Вставить("lead_id", НайденныеЛиды);
	        ОтборПроверки.Вставить("stage",   СтрокаДанных.stage);
	        
	        // Читаем существующие записи с таким ключом
	        Проверка = РегистрыСведений.lead_stages.СоздатьНаборЗаписей();
	        Проверка.Отбор.lead_id.Установить(НайденныеЛиды);
	        Проверка.Отбор.stage.Установить(СтрокаДанных.stage);
	        Проверка.Прочитать();
	        
	        Если Проверка.Количество() > 0 Тогда
	            // Если запись уже существует — можно обновить ресурсы (entered_at/left_at) или пропустить
	            СообщениеПроцесса = "Запись стадии для лида " + СтрокаДанных.lead_id + 
	                                ", stage=" + СтрокаДанных.stage + " уже существует. Пропущена.";
	            // Чтобы НЕ прерывать цикл импорта при наличии данных — можно комментировать эту строку:
	            // Сообщить(СообщениеПроцесса); 
	            Продолжить;
	        КонецЕсли;
	        
	        // --- 3. Добавляем новую запись в набор ---
	        НоваяЗапись = НаборЗаписей.Добавить();
	        
	        // Ключевые измерения
	        НоваяЗапись.lead_id  = НайденныеЛиды;          // Ссылка на справочник!
	        НоваяЗапись.stage    = СтрокаДанных.stage;     // Тип зависит от структуры регистра (строка/перечисление)
	        
	        // Ресурсы (значения)
	        НоваяЗапись.entered_at  = СтрокаДанных.entered_at;
	        НоваяЗапись.left_at     = СтрокаДанных.left_at;
	        
	    КонецЦикла;
	    
	    // --- 4. Записываем все изменения в один пакет ---
	    НаборЗаписей.Записать(Ложь);
	    
	КонецЕсли;
	
	
	//Запись contacts
	
	Если Объект.contacts.Количество() > 0 Тогда
    
	    // 1. Собираем данные для кэширования
	    МассивLeadID = Новый Массив;
	    Для Каждого Стр Из Объект.contacts Цикл
	        МассивLeadID.Добавить(Стр.lead_id);
	    КонецЦикла;
	    
	    // 2. Предварительно находим все Ссылки на Лиды (чтобы не искать их в цикле)
	    КэшСсылокЛидов = ПолучитьКэш("leads", "lead_id", МассивLeadID);
	    
	    // 3. Предварительно находим существующие контакты, чтобы избежать дублей
	    // Используем спец. функцию для поиска по двум полям
	    КэшСуществующихКонтактов = ПолучитьКэшКонтактов(МассивLeadID);
	    
	    НачатьТранзакцию();
	    Попытка
	        Для Каждого СтрокаДанных Из Объект.contacts Цикл
	            
	            // Проверка: существует ли Лид в базе
	            СсылкаНаЛид = КэшСсылокЛидов.Получить(СтрокаДанных.lead_id);
	            Если СсылкаНаЛид = Неопределено Тогда
	                // Лид не найден в кэше — значит его нет в базе
	                Продолжить; 
	            КонецЕсли;

	            // Проверка на дубль контакта (по lead_id + full_name)
	            КлючДубля = Строка(СтрокаДанных.lead_id) + "|" + СтрокаДанных.full_name;
	            Если КэшСуществующихКонтактов.Получить(КлючДубля) <> Неопределено Тогда
	                Продолжить;
	            КонецЕсли;

	            // Создание контакта
	            НовыйКонтакт = Справочники.contacts.СоздатьЭлемент();
	            НовыйКонтакт.ОбменДанными.Загрузка = Истина;
				//НовыйКонтакт.lead_id = СтрокаДанных.lead_id;
				НовыйКонтакт.lead_id = СсылкаНаЛид;
	            НовыйКонтакт.full_name = СтрокаДанных.full_name;
	            НовыйКонтакт.email = СтрокаДанных.email;
	            // Если в справочнике contacts есть реквизит-ссылка на Лид, заполните его здесь:
	            // НовыйКонтакт.ВладелецЛид = СсылкаНаЛид; 
	            
	            НовыйКонтакт.Записать();
	            
	            // Добавляем в кэш, чтобы не создать дубль, если он встретится дважды в текущей загрузке
	            КэшСуществующихКонтактов.Вставить(КлючДубля, НовыйКонтакт.Ссылка);
	            
	        КонецЦикла;
	        
	        ЗафиксироватьТранзакцию();
	        Сообщить("Загрузка контактов завершена.");
	    Исключение
	        ОтменитьТранзакцию();
	        Сообщить("Ошибка загрузки контактов: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;


    Если Объект.leads.Количество() = 0 
       И Объект.lead_stages.Количество() = 0 
       И Объект.sources.Количество() = 0
       И Объект.employees.Количество() = 0
       И Объект.contacts.Количество() = 0 Тогда
        Сообщить("Нет данных для записи");
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьКэш(ИмяСправочника, ИмяРеквизита, МассивЗначений)
    
    Результат = Новый Соответствие;
    
    // Убираем дубли из массива, чтобы запрос был легче
    Стр = Новый Структура;
    Стр.Вставить("Значения", МассивЗначений);
    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("Значение");
    Для Каждого ТекЗнач Из МассивЗначений Цикл
        ТЗ.Добавить().Значение = ТекЗнач;
    КонецЦикла;
    ТЗ.Свернуть("Значение");
    ЧистыйМассив = ТЗ.ВыгрузитьКолонку("Значение");

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ

        |	Т.Ссылка КАК Ссылка,
        |	Т." + ИмяРеквизита + " КАК Ключ
        |ИЗ

        |	Справочник." + ИмяСправочника + " КАК Т
        |ГДЕ
        |	Т." + ИмяРеквизита + " В (&МассивЗначений)";
    
    Запрос.УстановитьПараметр("МассивЗначений", ЧистыйМассив);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Вставить(Выборка.Ключ, Выборка.Ссылка);
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ПолучитьКэшКонтактов(МассивLeadID)
    Результат = Новый Соответствие;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ

        |	Т.Ссылка,
        |	Т.lead_id КАК lead_id,
        |	Т.full_name КАК full_name

        |ИЗ
        |	Справочник.contacts КАК Т
        |ГДЕ

        |	Т.lead_id В (&МассивLeadID)";
    
    Запрос.УстановитьПараметр("МассивLeadID", МассивLeadID);
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        // Создаем уникальный составной ключ для поиска в памяти
        Ключ = Строка(Выборка.lead_id) + "|" + Выборка.full_name;
        Результат.Вставить(Ключ, Выборка.Ссылка);
    КонецЦикла;
    
    Возврат Результат;
КонецФункции


	